<file path="src/utils/timezoneService.ts">
// Import spacetime dynamically to handle ESM modules
const spacetimeImport = import('spacetime');

export interface UserTimezone {
  userId: string;
  timezone: string;
}

// Default timezone if none is set
const DEFAULT_TIMEZONE = 'UTC';

// In-memory cache of user timezones
// In a production environment, this should be stored in a database
const userTimezones: Map<string, string> = new Map();

/**
 * Set a user's timezone preference
 * @param userId The Discord user ID
 * @param timezone The timezone string (e.g., 'America/Los_Angeles')
 */
export function setUserTimezone(userId: string, timezone: string): void {
  userTimezones.set(userId, timezone);
}

/**
 * Get a user's timezone preference
 * @param userId The Discord user ID
 * @returns The user's timezone or DEFAULT_TIMEZONE if not set
 */
export function getUserTimezone(userId: string): string {
  return userTimezones.get(userId) || DEFAULT_TIMEZONE;
}

/**
 * Get the current date in the user's timezone
 * @param userId The Discord user ID
 * @returns The current date in YYYY-MM-DD format in the user's timezone
 */
export async function getCurrentDateInUserTimezone(userId: string): Promise<string> {
  const timezone = getUserTimezone(userId);
  const spacetime = (await spacetimeImport).default;
  return spacetime.now(timezone).format('iso-short');
}

/**
 * Get the start of the current day in the user's timezone
 * @param userId The Discord user ID
 * @returns The start of the day timestamp in UTC
 */
export async function getStartOfDayInUTC(userId: string): Promise<number> {
  const timezone = getUserTimezone(userId);
  const spacetime = (await spacetimeImport).default;
  return spacetime.now(timezone).startOf('day').toNativeDate().getTime();
}

/**
 * Get the end of the current day in the user's timezone
 * @param userId The Discord user ID
 * @returns The end of the day timestamp in UTC
 */
export async function getEndOfDayInUTC(userId: string): Promise<number> {
  const timezone = getUserTimezone(userId);
  const spacetime = (await spacetimeImport).default;
  return spacetime.now(timezone).endOf('day').toNativeDate().getTime();
}

/**
 * Format a timestamp to a localized time string
 * @param timestamp The UTC timestamp
 * @param userId The Discord user ID
 * @returns Formatted time string in the user's timezone
 */
export async function formatTimeInUserTimezone(timestamp: number, userId: string): Promise<string> {
  const timezone = getUserTimezone(userId);
  const spacetime = (await spacetimeImport).default;
  return spacetime(timestamp, timezone).format('time');
}

/**
 * Convert a local time string to UTC timestamp
 * @param timeString Time string in HH:mm format
 * @param userId The Discord user ID
 * @returns UTC timestamp
 */
export async function localTimeToUTC(timeString: string, userId: string): Promise<number> {
  const timezone = getUserTimezone(userId);
  const spacetime = (await spacetimeImport).default;
  const [hours, minutes] = timeString.split(':').map(Number);
  return spacetime.now(timezone)
    .hour(hours)
    .minute(minutes)
    .toNativeDate()
    .getTime();
}
